# Copy this file to .env and configure your preferred generator mode:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# GENERATOR MODE — controls how answers are generated
# ---------------------------------------------------------------------------
# local   (default) No API key needed. Returns top retrieved chunk as answer.
#                   Works immediately. Best for testing.
# groq              Free LLM API using Llama3. Fast. No cost.
#                   Get key at: https://console.groq.com (free signup)
# openai            OpenAI GPT-3.5/4. Requires paid API key.
# ---------------------------------------------------------------------------
GENERATOR_MODE=local

# ---------------------------------------------------------------------------
# Groq (free) — only needed if GENERATOR_MODE=groq
# ---------------------------------------------------------------------------
# GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=llama3-8b-8192

# ---------------------------------------------------------------------------
# OpenAI — only needed if GENERATOR_MODE=openai
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=your_openai_key_here
